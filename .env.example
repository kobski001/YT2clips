# YouTube Clipper configuration (all optional). Copy to .env in the skill folder
# or in the folder you run Claude Code from.

# --- FFmpeg -----------------------------------------------------------------
# Path to an ffmpeg binary with libass (auto-detected if empty)
FFMPEG_PATH=
# libx264 (default, best quality) or nvenc (NVIDIA GPU, faster)
VIDEO_ENCODER=libx264
X264_PRESET=medium
X264_CRF=19

# --- Output -----------------------------------------------------------------
OUTPUT_DIR=./youtube-clips
MAX_VIDEO_HEIGHT=1080

# --- Whisper ----------------------------------------------------------------
# auto | faster | openai
WHISPER_ENGINE=auto
# Empty = large-v3-turbo on GPU, small.en on CPU. Others: medium.en, large-v3, distil-large-v3
WHISPER_MODEL=
# auto | cuda | cpu
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=

# --- Captions ---------------------------------------------------------------
# Any installed font name (default: Arial Black for karaoke/pop, Arial for classic/boxed)
SUBTITLE_FONT=
# Folder of .ttf/.otf files to use (e.g. Montserrat, Poppins, Bebas Neue)
SUBTITLE_FONTS_DIR=
# yellow | green | cyan | pink | orange | red | white | #RRGGBB
SUBTITLE_HIGHLIGHT=yellow

# --- yt-dlp -----------------------------------------------------------------
YT_DLP_PROXY=
# chrome | firefox | edge | safari  (for age-restricted / members-only videos)
YT_DLP_COOKIES_FROM_BROWSER=
